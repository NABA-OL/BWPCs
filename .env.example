# Copia este archivo como .env.local y completa los valores.
# .env.local está en .gitignore — nunca se commitea.

# Cadena de conexión de MongoDB Atlas.
# En Vercel ya existe como variable del proyecto (la creó la integración).
# Para desarrollo local: cópiala desde Atlas/Vercel o usa `vercel env pull .env.local`.
MONGODB_URI=

# Nombre de la base de datos.
MONGODB_DB=nameBD

# Secreto para firmar los JWT de sesión del admin (cadena aleatoria larga).
# Genera uno con: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=

# (Opcional) credenciales del admin inicial para el seed.
ADMIN_USER=prueba
ADMIN_PASSWORD=prueba

# Secreto del cron de la TRM. Defínelo en Vercel y la plataforma enviará
# "Authorization: Bearer <CRON_SECRET>" al invocar /api/cron/trm cada día.
# Genera uno con: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CRON_SECRET=
INSTAGRAM_VERIFY_TOKEN=cadena que tú inventas, la misma que registras en el panel de Meta al configurar el webhook.
INSTAGRAM_APP_SECRET=App Secret de tu app de Meta (Settings → Basic).
INSTAGRAM_ACCESS_TOKEN=no se usa en este endpoint (es solo para enviar mensajes/llamar la Graph API después), pero agrégala ya para cuando implementes el envío de respuestas.

# (Opcional) notifica por Telegram cada solicitud de cotización enviada desde
# el cotizador público. Si falta cualquiera de las dos primeras, la
# notificación simplemente no se envía (el lead se guarda igual en la BD).
# Crea el bot con @BotFather, agrégalo al grupo, y saca el chat_id con
# https://api.telegram.org/bot<TOKEN>/getUpdates después de escribir algo en el grupo.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Temas (forum topics) del grupo: una variable por tipo de aviso, con el id numérico
# del tema (el último número del enlace t.me/c/<grupo>/<tema>). Todas son opcionales:
# si falta una se usa TELEGRAM_THREAD_ID (compatibilidad con la configuración anterior)
# y, si tampoco está, el mensaje llega al tema General.
# Solicitudes del cotizador:
TELEGRAM_THREAD_SOLICITUDES=8
# Cambios pedidos a una cotización:
TELEGRAM_THREAD_COTIZACIONES=4
# "Quiere comprar":
TELEGRAM_THREAD_COMPRAS=5
# Pagos reportados, correcciones de cuentas de cobro y pagos de Bold:
TELEGRAM_THREAD_PAGOS=3
# Reseñas por moderar:
TELEGRAM_THREAD_RESENAS=2
# Cuentas nuevas verificadas y cuentas eliminadas:
TELEGRAM_THREAD_CUENTAS=6
# Borradores de blog y noticias:
TELEGRAM_THREAD_CONTENIDO=7
# Variables anteriores, aún válidas como respaldo:
TELEGRAM_THREAD_ID=
TELEGRAM_CONTENT_THREAD_ID=

# API key de Google AI Studio (https://aistudio.google.com/apikey) — redacta
# los borradores de blog con Gemini (gemini-3.6-flash, tier gratis). Sin esta
# var, el botón "Redactar borrador nuevo" y el cron semanal fallan.
GEMINI_API_KEY=

# ---------------------------------------------------------------------------
# Cuentas de usuario público (plan por fases). Ninguna se usa todavía: se
# activan al implementar la fase 1. Llénalas en .env.local y en Vercel
# (Production, Preview y Development).
# ---------------------------------------------------------------------------

# Secreto de las sesiones de USUARIOS. Debe ser DISTINTO de AUTH_SECRET (que es
# del admin): así un token de usuario nunca valida contra /admin.
# Genera uno con: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=
# URL base del sitio: http://localhost:3000 en local, https://bw-pcs.com en producción.
BETTER_AUTH_URL=http://localhost:3000

# Resend: correos de verificación (código de 6 dígitos) y "tu cotización está
# lista". API key en https://resend.com/api-keys; el dominio bw-pcs.com debe
# estar verificado (registros SPF y DKIM en el DNS).
RESEND_API_KEY=
# Remitente. Debe usar el dominio verificado en Resend.
EMAIL_FROM=B & W <no-reply@bw-pcs.com>
# (Opcional) a dónde llegan las respuestas de los clientes.
EMAIL_REPLY_TO=bandwmount@gmail.com

# Upstash Redis: límite de intentos de login, registro y códigos. Copia la REST
# URL y el REST Token de la base en la consola de Upstash. Si la base es
# compartida con otros proyectos, las claves de B & W usarán el prefijo "bw:".
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Interruptor de las cuentas de usuario. Con "true" se muestran el botón de
# cuenta en el header y las rutas /cuenta/* y /api/user-auth/*; sin él (o en
# cualquier otro valor) todo responde 404. No lo actives en producción hasta
# tener listas las fases legal y de recuperación de contraseña.
NEXT_PUBLIC_ACCOUNTS_ENABLED=

# Cloudflare R2: fotos de las reseñas (fase 5). Crea el bucket en Cloudflare →
# R2, actívale un dominio público propio (Settings → Custom Domains, ej.
# img.bw-pcs.com; el r2.dev de pruebas no sirve en producción) y crea un token de
# API con permiso "Object Read & Write" limitado a ese bucket. El Account ID sale
# en la página de R2. Sin estas variables, en desarrollo las fotos se guardan en
# public/_dev-uploads; en producción la subida responde 503.
# Un bucket por entorno: producción (dominio propio img.bw-pcs.com), QA (su URL
# pública de desarrollo) y en local déjalas vacías. Las fotos van en img-resenas/.
# No filtres el token por IP: Vercel no tiene IPs de salida fijas en Hobby.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=bw-pcs-storage
R2_PUBLIC_URL=https://img.bw-pcs.com
# Bucket PRIVADO de comprobantes de pago: otro bucket, con el acceso público DESACTIVADO y el
# mismo token con permiso también sobre él. Sin esto, en producción no se pueden reportar pagos.
R2_PRIVATE_BUCKET=

# Google OAuth (opcional): "Continuar con Google" en ingreso y registro; sin estas dos el botón no
# se muestra. Se crean en Google Cloud Console → Google Auth Platform → Clientes (aplicación web).
# Permisos: solo openid, email y profile. URI de redireccionamiento autorizados:
#   https://<dominio>/api/user-auth/callback/google   (y http://localhost:3000/... en local)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# (Opcional) anti-spam del formulario de cotización con reCAPTCHA v3.
# Sin estas dos, el formulario funciona igual, solo sin la verificación.
# Site key: pública, se expone al navegador (por eso NEXT_PUBLIC_).
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
# Secret key: nunca se expone, solo la usa el servidor para verificar el token.
RECAPTCHA_SECRET_KEY=
# Bold (pago con tarjeta por enlace de pago; https://developers.bold.co). Llaves de integración del
# comercio en "Integraciones > Llaves de integración" (API Link de pagos). Opcionales: sin ellas la
# tarjeta no se ofrece en línea. La secreta solo en el servidor; nunca en NEXT_PUBLIC_*.
BOLD_API_KEY=
BOLD_SECRET_KEY=
# test | live. Sin ella: producción = live, todo lo demás = test. El modo test NUNCA se acepta en
# producción (su firma de webhook usa clave vacía). Webhook a registrar en el panel de Bold:
# https://<tu-dominio>/api/webhooks/bold
BOLD_MODE=
